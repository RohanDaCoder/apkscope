<?xml version="1.0" encoding="utf-8"?>
<!--
  A demo patch bundle: one of every kind of edit, against the demo app of
  tests/apkscope/commands_patch.rs (com.example.app, versionName 2.1, versionCode 21), so this
  file is run by the tests and cannot drift from the format. The format: docs/patch-bundles.md.
-->
<bundle name="Demo unlock" author="apkscope" version="2" description="one of every edit">
  <!-- checked against the APK's manifest before anything runs -->
  <target package="com.example.app" versionName="2.1" minVersionCode="21" maxVersionCode="29"/>

  <!-- stub a method to return a constant. sig names one overload
       exactly; without it, every method of that name. value is typed by the return type:
       true / false for Z, a number or 0x hex for the numeric ones, null for references. -->
  <patch name="Unlock" description="isPurchased() returns true">
    <return class="com.example.app.License" method="isPurchased" sig="()Z" value="true"/>
  </patch>

  <!-- alternatives: the first that lands is applied, the rest skipped. The ad id is where
       the old version had it, AdView, or where this one has it, AdLoader — whichever the
       app has, the patch finds it, and if it has neither the error says so. -->
  <patch name="Remove ads" description="the ad unit id is emptied, wherever it lives">
    <any>
      <replace class="com.example.app.AdView" method="unit"
               from="ca-app-pub-394" to="0"/>
      <replace class="com.example.app.AdLoader" method="load"
               from="ca-app-pub-394" to="0"/>
    </any>
  </patch>

  <!-- a replace of several lines: the from lines name the block the smali prints, and the
       to lines replace it whole. Indentation is the XML's own; each line is trimmed. -->
  <patch name="Quiet load" description="load() sets no flag">
    <replace class="com.example.app.AdLoader" method="load"
             from="const/4 v1, 0x1
                   return-void"
             to="const/4 v1, 0x0
                 return-void"/>
  </patch>

  <!-- a whole new method body, in smali: .locals first, then the code. The class is
       re-assembled from it, so the assembler checks the body. This one uses the parameter
       p1 (the (Ljava/lang/String;)Z overload): the id is purchased when it starts with
       "patched". -->
  <patch name="Trial ids" description="isPurchased(String) starts its own check">
    <body class="com.example.app.License" method="isPurchased" sig="(Ljava/lang/String;)Z">
      .locals 1
      const-string v0, "patched"
      invoke-virtual {p1, v0}, Ljava/lang/String;->startsWith(Ljava/lang/String;)Z
      move-result v0
      return v0
    </body>
  </patch>

  <!-- one string resource, like build --string: the element's text is the new value -->
  <patch name="Strings">
    <string name="app_name">Patched app</string>
  </patch>

  <!-- files: an entry from a file next to this bundle (or delete one) -->
  <patch name="Files">
    <entry name="assets/config.json" src="config.json"/>
    <entry name="META-INF/stale.SF" delete="yes"/>
  </patch>
</bundle>
